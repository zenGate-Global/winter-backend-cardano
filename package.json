{
  "name": "winter-backend-cardano",
  "version": "0.1.0",
  "description": "Service for the Winter protocol on Cardano.",
  "author": "zenGate Global",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "pnpm exec tsc --noEmit",
    "check:recreate-alignment": "ts-node -r tsconfig-paths/register src/palmyra/recreate-alignment.check.ts",
    "check:reconcile-exhausted": "pnpm build && node dist/palmyra/reconcile-exhausted.check.js",
    "check:reconciler": "pnpm build && node dist/palmyra/reconciler.check.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "docs-lint": "python3 scripts/ste-check.py AGENTS.md CLAUDE.md .omp/RULES.md .omp/AGENTS.md .omp/agents .omp/commands"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.1.1",
    "@meshsdk/core": "1.9.1",
    "@meshsdk/core-csl": "1.9.1",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.1",
    "@zengate/winter-cardano-mesh": "2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.21.0",
    "pg-boss": "12.18.2",
    "pinata": "^2.5.6",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.30",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "chacha-native",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "@zengate/winter-cardano-mesh>@meshsdk/core": "1.9.1",
      "ip-address": "^10.1.1",
      "undici": "^6.24.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
