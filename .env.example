# Cardano Network and Wallet
NETWORK=
ZENGATE_WALLET_MNEMONIC=
TRANSACTION_RETRY_ATTEMPTS=

# Cardano Node and Blockchain Services
BLOCKFROST_KEY=
DEPLOYER_ADDRESS=

# IPFS Services
PINATA_JWT=
NEXT_PUBLIC_GATEWAY_URL=

# Auth
WINTER_API_KEY=

# Database and Queue
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SYNC=
POSTGRES_LOGGING=
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=2
PORT=

# Reconciliation sweep. A row that says ERROR while holding a transaction hash
# may describe a transaction that reached the chain. The sweep looks each one up
# and promotes it. Set the interval to 0 to switch the sweep off.
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_BATCH_SIZE=25
